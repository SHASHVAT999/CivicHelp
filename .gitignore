# Dependencies
**/node_modules/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Uploaded user content (keep directory tracked with .gitkeep)
**/uploads/*
!**/uploads/.gitkeep

# Generated frontend artifacts
**/build/
**/coverage/

# Terraform state, backup, and local variable overrides
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Explicitly track Terraform provider lockfile
!.terraform.lock.hcl

# Dynamic CI/CD and deployment artifacts
ec2_ip.txt
**/ec2_ip.txt
ansible/inventory.ini
**/inventory.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Private keys and certificates
*.pem
*.p12
*.pfx
*.key

# Operating system files
.DS_Store
Thumbs.db
