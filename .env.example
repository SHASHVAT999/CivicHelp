# ==============================================================================
# CivicHelp Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Docker Compose automatically loads .env from the project root.
# Local backend processes will also load .env from the project root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# The canonical database schema is root 'init.sql' (backend/models/db.sql does not exist).
# In Docker, init.sql is executed automatically from /docker-entrypoint-initdb.d/init.sql.
#
# DB_HOST:
# - For Docker Compose: backend container automatically connects via service name 'db'
# - For local development on Windows: set DB_HOST=127.0.0.1 (or localhost)
# When running MySQL via Docker Compose, port 3306 is bound to loopback only (127.0.0.1:3306)
# to prevent public exposure while allowing local host tools to connect.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=civichelp

# ------------------------------------------------------------------------------
# 2. Backend Server & Security Configuration (Required)
# ------------------------------------------------------------------------------
# Backend HTTP server port
PORT=5001

# Generate a secure random secret for signing JWT tokens:
JWT_SECRET=your_jwt_secret_key_change_in_production

# Allowed frontend origins for CORS and Socket.IO (comma-separated list supported):
# - Local React dev server: http://localhost:3000
# - Docker / Nginx reverse proxy: http://localhost
# - AWS / production domain: http://<ec2-public-ip> or https://yourdomain.com
CLIENT_URL=http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# 3. Email Notification Configuration (Optional)
# ------------------------------------------------------------------------------
# If left blank, email notifications are safely disabled and the app runs normally.
# To enable Gmail SMTP notifications:
#   1. Use a Google account with 2-Step Verification enabled.
#   2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Optional for local dev, used during build/Docker)
# ------------------------------------------------------------------------------
# For local React development (npm start on port 3000):
#   REACT_APP_API_URL=http://localhost:5001/api
#   REACT_APP_SOCKET_URL=http://localhost:5001
# For Docker / Nginx reverse proxy (port 80):
#   REACT_APP_API_URL=/api
#   REACT_APP_SOCKET_URL=/
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_SOCKET_URL=http://localhost:5001
